# Server-side only (Vercel env var / local .env for `vercel dev`). Never prefix with VITE_.
GEMINI_API_KEY=

# Optional: extra comma-separated origins allowed to call /api/gemini (e.g. a custom domain).
ALLOWED_ORIGINS=

# Android build only: full URL of your Vercel deployment, e.g. https://wealthsenseai.vercel.app
VITE_API_BASE_URL=

# Android release only: AdMob "Bottom Banner" ad unit ID. Leave empty to use Google's test ads.
VITE_ADMOB_BANNER_ID=

# Optional: comma-separated hashed IDs of your own phones, so they get test ads from the real unit.
# Find yours in logcat: the Ads SDK prints a setTestDeviceIds(...) hint on first launch.
VITE_ADMOB_TEST_DEVICE_IDS=
